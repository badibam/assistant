#!/usr/bin/env python3
"""Entry point for the Assistant development tasks.

Bare invocation opens the interactive menu; `./run <task>` runs one directly,
without requiring questionary.
"""

import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from xml.etree import ElementTree

ROOT = Path(__file__).resolve().parent
GRADLEW = ROOT / "gradlew"

# The two builds live side by side on a device, being two applications as far as Android
# is concerned, with separate databases. Which is the point of the suffix, and the reason
# anything that talks to "the app" has to say which one it means.
APPLICATION_ID = "com.assistant"
DEBUG_APPLICATION_ID = "com.assistant.debug"

# The release signing key, which lives outside the repository on purpose: a gitignored
# file at the root would still be swept away by `git clean -xdf`, and this one cannot be
# regenerated -- it is the app's identity to every phone that installed it.
SIGNING = Path.home() / ".config" / "assistant" / "signing.env"

# What the compiler says that is worth reading: the errors, and the verdict.
BUILD_LINES = ("e:", "Error:", "ERROR:", "BUILD SUCCESSFUL", "BUILD FAILED")

# Where gradle leaves the machine-readable test results, and the report for a human.
TEST_RESULTS = ROOT / "app" / "build" / "test-results" / "testDebugUnitTest"
TEST_REPORT = ROOT / "app" / "build" / "reports" / "tests" / "testDebugUnitTest" / "index.html"


def gradle(*args):
    """Delegate to the wrapper, never to a system-wide gradle."""
    return subprocess.run([str(GRADLEW), *args], cwd=ROOT, check=False).returncode


def gradle_env(extra, *args):
    """Same, with the signing key's variables added to the environment."""
    return subprocess.run([str(GRADLEW), *args], cwd=ROOT, check=False,
                          env={**os.environ, **extra}).returncode


def gradle_filtered(*args):
    """Run gradle and print only the error lines and the verdict.

    Kotlin compilation output buries a type error under hundreds of task lines, and the
    one thing wanted from a type check is whether it passed and where it did not.
    """
    process = subprocess.Popen(
        [str(GRADLEW), *args], cwd=ROOT,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    for line in process.stdout:
        if line.startswith(BUILD_LINES):
            print(line, end="")
    return process.wait()


def gradle_tests(*args):
    """Run gradle and print the compiler errors, the failing tests, and the verdict.

    The compile filter alone is not enough here: a failing test prints
    "SomeTest > someCase FAILED" and its exception, none of which starts with the prefixes
    a type error uses. Filtering on those alone would report BUILD FAILED without ever
    saying which test broke, which is the one thing wanted from a test run.
    """
    process = subprocess.Popen(
        [str(GRADLEW), *args], cwd=ROOT,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    for line in process.stdout:
        if line.startswith(BUILD_LINES) or " FAILED" in line:
            print(line, end="")
    return process.wait()


def test_tally(not_before):
    """Return (tests, failures, errors, fresh) from gradle's JUnit XML, or None if absent.

    A green run prints BUILD SUCCESSFUL whether it ran two hundred tests or none at all --
    and it prints the same thing when gradle skips the task as up to date. Counting the
    cases turns the verdict into something that says what was actually checked.

    The results stay on disk from the run before, so a build that fails on its way to the
    tests -- a type error, a broken annotation processor -- would otherwise be reported with
    the last run's count beside its BUILD FAILED, which reads as a suite that passed. Hence
    `fresh`: whether anything was written since this run started. Results that are not are
    still worth reporting when the build succeeded, because gradle skipping the task as up
    to date is a legitimate pass -- neither the code nor the tests moved -- but the caller
    has to say so rather than present them as a run that just happened.
    """
    if not TEST_RESULTS.is_dir():
        return None
    reports = list(TEST_RESULTS.glob("*.xml"))
    if not reports:
        return None
    tests = failures = errors = 0
    for report in reports:
        root = ElementTree.parse(report).getroot()
        tests += int(root.get("tests", 0))
        failures += int(root.get("failures", 0))
        errors += int(root.get("errors", 0))
    fresh = any(r.stat().st_mtime >= not_before for r in reports)
    return tests, failures, errors, fresh


def attached_devices():
    """Return [(serial, state)] as adb reports them."""
    probe = subprocess.run(
        ["adb", "devices"], capture_output=True, text=True, check=False
    )
    rows = []
    for line in probe.stdout.splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2:
            rows.append((fields[0], fields[1]))
    return rows


def ready_device():
    """Return the serial of the one usable device, or None after explaining why not.

    adb reports a phone that is plugged in but not paired as `unauthorized`, and gradle
    then claims there is no device at all. Diagnosing here turns a dead end into an
    instruction.
    """
    if shutil.which("adb") is None:
        print("adb not found in PATH.", file=sys.stderr)
        return None

    devices = attached_devices()
    ready = [serial for serial, state in devices if state == "device"]
    if len(ready) == 1:
        return ready[0]
    if len(ready) > 1:
        print("Several devices are ready:", file=sys.stderr)
        for serial in ready:
            print(f"  {serial}", file=sys.stderr)
        print("Pick one with: export ANDROID_SERIAL=<serial>", file=sys.stderr)
        return None

    if not devices:
        print(
            "No device attached. Check that the cable carries data rather than power\n"
            "only, and that USB debugging is on in the developer options.",
            file=sys.stderr,
        )
        return None

    for serial, state in devices:
        if state == "unauthorized":
            print(
                f"{serial} has not authorised this computer.\n"
                "Unlock the phone and accept the 'Allow USB debugging' prompt, ticking\n"
                "'Always allow from this computer'. If no prompt shows up, replug, or\n"
                "revoke the USB debugging authorisations in the developer options.",
                file=sys.stderr,
            )
        elif state == "offline":
            print(
                f"{serial} is offline. Replug it, or restart the bridge:\n"
                "  adb kill-server && adb start-server",
                file=sys.stderr,
            )
        else:
            print(f"{serial} is in state '{state}', not usable.", file=sys.stderr)
    return None


def launch(application_id):
    """Start the application that was just installed.

    A freshly installed package sits stopped and never launched, and a textual launcher is
    free to leave it out of its list until it has run once. Running it settles that, and
    puts it on screen besides.

    The activity is asked for rather than written down: it lives under the namespace while
    the package carries the build type's suffix, so the pair is not guessable from either.
    """
    probe = subprocess.run(
        ["adb", "shell", "cmd", "package", "resolve-activity", "--brief",
         "-c", "android.intent.category.LAUNCHER", application_id],
        capture_output=True, text=True, check=False,
    )
    component = probe.stdout.strip().splitlines()[-1].strip() if probe.stdout.strip() else ""
    if "/" not in component:
        print(f"{application_id} declares no launcher activity to start.", file=sys.stderr)
        return
    subprocess.run(["adb", "shell", "am", "start", "-n", component],
                   capture_output=True, check=False)


def running(application_id):
    """The pid of that application on the device, or None."""
    probe = subprocess.run(
        ["adb", "shell", "pidof", "-s", application_id],
        capture_output=True, text=True, check=False,
    )
    return probe.stdout.strip() or None


def task_compile():
    """Type-check the sources without building anything installable."""
    return gradle_filtered("compileDebugKotlin")


def task_test():
    """Run the unit tests and say how many ran.

    These are the JVM tests under app/src/test: pure decision logic -- the AI state
    machine, the schedule calculator, the field migration comparison -- with no device,
    no emulator and no database behind them. A run takes seconds, which is the point:
    each case here is a check that would otherwise mean installing the build on a phone
    and reproducing the situation by hand.
    """
    # Noted before the run, so that results left by the run before cannot be read as this
    # one's. A filesystem timestamp can lag by a second, hence the margin.
    started = time.time() - 1
    code = gradle_tests("testDebugUnitTest")
    tally = test_tally(not_before=started)

    # Nothing written by this run: trustworthy only if the build got through, in which case
    # gradle skipped the task because nothing had changed. Otherwise there is no answer.
    if tally is None or (not tally[3] and code != 0):
        print("no results from this run -- it did not get as far as the tests")
        return code or 1

    tests, failures, errors, fresh = tally
    bad = failures + errors
    unchanged = "" if fresh else ", unchanged since the last run"
    print(f"{tests} tests, {bad} failed{unchanged}")
    if bad:
        print(f"report: {TEST_REPORT}")
    return code


def task_strings():
    """Regenerate strings_generated.xml from the XML sources."""
    return gradle("generateStringResources")


def task_build():
    return gradle("assembleDebug")


def task_install():
    if ready_device() is None:
        return 1
    code = gradle("installDebug")
    if code == 0:
        launch(DEBUG_APPLICATION_ID)
    return code


def signing():
    """Read the signing key's environment, or None when there is none.

    Parsed rather than sourced: this only ever needs four `export NAME=value` lines, and
    handing a file to a shell to run is a much larger thing to allow than reading it.
    """
    if not SIGNING.is_file():
        return None
    values = {}
    for line in SIGNING.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line.startswith("export "):
            continue
        name, _, value = line[len("export "):].partition("=")
        values[name.strip()] = value.strip().strip("'\"")
    return values


def task_release():
    """Assemble the release, signed with the key that lives outside the repository.

    It refuses rather than building unsigned: Android installs no unsigned APK, so the
    file would be rejected by the phone much later, for no visible reason. F-Droid is the
    exception -- it signs with its own key -- and does not go through here.
    """
    keys = signing()
    if keys is None:
        print(
            f"No signing key at {SIGNING}.\n"
            "Run scripts/generate_keystore.sh to create one, or restore it from your\n"
            "backup: this key is the app's identity to every phone that installed it,\n"
            "and no update installs over a differently signed one.",
            file=sys.stderr,
        )
        return 1
    print(f"Signing with the key named by {SIGNING}.", flush=True)
    code = gradle_env(keys, "assembleRelease")
    if code == 0:
        apk = release_apk()
        if apk is not None:
            subprocess.run(["./verify_signature.sh", str(apk)],
                           cwd=ROOT / "scripts", check=False)
    return code


def release_apk():
    """The release APK gradle just wrote, or None."""
    outputs = ROOT / "app/build/outputs/apk/release"
    apks = sorted(outputs.glob("*.apk")) if outputs.is_dir() else []
    return apks[-1] if apks else None


def task_install_release():
    """Assemble the release and put it on the device.

    Not `installRelease`: going through adb keeps a refusal to install an ordinary answer
    from Android rather than a gradle task failing for its own reasons.
    """
    if ready_device() is None:
        return 1
    if task_release() != 0:
        return 1
    apk = release_apk()
    if apk is None:
        print("No release APK was produced.", file=sys.stderr)
        return 1
    subprocess.run(["adb", "install", "-r", str(apk)], check=False)
    launch(APPLICATION_ID)
    return 0


def task_logs(which=None):
    """Follow one build's log.

    logcat takes a single --pid, so with both builds installed -- the ordinary state of a
    device one tests releases on -- something has to choose. Whichever is running when
    only one is; the debug build when both are, that being the working loop.
    """
    if ready_device() is None:
        return 1
    ids = {"debug": DEBUG_APPLICATION_ID, "release": APPLICATION_ID}
    if which is not None and which not in ids:
        print(f"Unknown build: {which}. Say 'debug' or 'release'.", file=sys.stderr)
        return 1

    if which is None:
        up = {name: running(app) for name, app in ids.items()}
        up = {name: pid for name, pid in up.items() if pid}
        if not up:
            print("Neither build is running on the device.", file=sys.stderr)
            return 1
        which = "debug" if "debug" in up else "release"
        if len(up) > 1:
            other = "release" if which == "debug" else "debug"
            print(f"Both are running; following {which}. For the other: ./run logs {other}")

    pid = running(ids[which])
    if not pid:
        print(f"{ids[which]} is not running on the device.", file=sys.stderr)
        return 1
    return subprocess.run(["adb", "logcat", f"--pid={pid}"], check=False).returncode


def task_devices():
    if shutil.which("adb") is None:
        print("adb not found in PATH.", file=sys.stderr)
        return 1
    return subprocess.run(["adb", "devices", "-l"], check=False).returncode


def task_db():
    """Back up or restore the device database, for migration testing."""
    return subprocess.run(["./db_backup_restore.sh"], cwd=ROOT / "scripts",
                          check=False).returncode


def task_clean():
    return gradle("clean")


ACTIONS = {
    "compile": task_compile,
    "test": task_test,
    "strings": task_strings,
    "build": task_build,
    "install": task_install,
    "logs": task_logs,
    "devices": task_devices,
    "release": task_release,
    "install-release": task_install_release,
    "db": task_db,
    "clean": task_clean,
}

LABELS = {
    "compile": "compile    type-check the sources, errors and verdict only",
    "test": "test       run the unit tests, failures and count only",
    "strings": "strings    regenerate the string resources",
    "build": "build      assemble the debug APK",
    "install": "install    assemble, install and start the debug build",
    "logs": "logs       follow logcat, filtered on the app",
    "devices": "devices    list attached devices and their state",
    "release": "release    assemble the signed release APK",
    "install-release": "install-release   assemble, install and start the release",
    "db": "db         back up or restore the device database",
    "clean": "clean      drop build outputs",
}

_QUIT = object()


def interruptible(action, *args):
    """Run a task so that Ctrl+C stops it and nothing else.

    Ctrl+C is how `logs` is meant to end, and how any build is abandoned: it returns to the
    menu, or to the shell with the conventional status, rather than dumping a traceback.
    """
    try:
        return action(*args) or 0
    except KeyboardInterrupt:
        print()
        return 130


def pause():
    try:
        input("\nEnter to continue ")
    except (EOFError, KeyboardInterrupt):
        pass


def menu():
    try:
        import questionary
        from questionary import Choice, Separator
    except ImportError:
        print(
            "questionary is missing: sudo apt install python3-questionary\n"
            "Direct invocation still works: ./run <task>",
            file=sys.stderr,
        )
        return 1

    choices = [Separator("Build")]
    choices += [Choice(LABELS[k], k) for k in ("compile", "strings", "build", "install")]
    choices += [Separator("Device")]
    choices += [Choice(LABELS[k], k) for k in ("logs", "devices", "db")]
    choices += [Separator("Release")]
    choices += [Choice(LABELS[k], k) for k in ("release", "install-release")]
    choices += [Separator(""), Choice(LABELS["clean"], "clean")]
    choices += [Choice("quit", _QUIT)]

    while True:
        os.system("clear")
        answer = questionary.select("assistant", choices=choices).ask()
        if answer is None or answer is _QUIT:
            return 0
        interruptible(ACTIONS[answer])
        pause()


def usage():
    print("Usage: ./run [task]\n\nTasks:")
    for key in ACTIONS:
        print(f"  {LABELS[key]}")


def main(argv):
    if not argv:
        return menu()
    task = argv[0]
    if task in ("-h", "--help"):
        usage()
        return 0
    if task not in ACTIONS:
        print(f"Unknown task: {task}\n", file=sys.stderr)
        usage()
        return 1
    return interruptible(ACTIONS[task], *argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
