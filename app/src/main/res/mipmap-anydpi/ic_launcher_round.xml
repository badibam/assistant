<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon, drawn in layers that the launcher masks to its own shape; the monochrome
     layer is the one Android tints when the user asks for themed icons. The layers are written
     by scripts/make_launcher_icon.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
