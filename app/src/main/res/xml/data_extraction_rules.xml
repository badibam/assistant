<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup and phone-to-phone transfer (Android 12 and above): the same exclusions as
     backup_rules.xml, for the same reasons. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="tailscale/" />
        <exclude domain="file" path="mcp/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tailscale/" />
        <exclude domain="file" path="mcp/" />
    </device-transfer>
</data-extraction-rules>
